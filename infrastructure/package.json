{
  "name": "hrambedminton-sk",
  "packageManager": "yarn@4.18.1",
  "version": "0.1.0",
  "bin": "bin/hrambedminton-sk.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "deploy:all": "cdk deploy --all",
    "lint": "eslint .",
    "lint:appsync": "eslint --config eslint-appsync.config.mjs .",
    "prettier:check": "prettier --check ./lib",
    "prettier:write": "prettier --write ./lib",
    "circle": "dpdm ./src/app.ts --ext .ts,.d.ts,.tsx,.mjs,.js,.jsx,.json --tsconfig ./tsconfig.json --tree false --ignore-skip-warning node_modules ./bin/hrambedminton-sk.ts"
  },
  "engines": {
    "node": ">=26.0.0 <27.0.0",
    "yarn": ">=4.0.0 <5.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1148.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "aws-jwt-verify": "^5.2.1",
    "zod": "^4"
  },
  "devDependencies": {
    "@aws-appsync/eslint-plugin": "^2.0.2",
    "@eslint/js": "^9.39.2",
    "@types/aws-lambda": "^8.10.159",
    "@types/node": "^26.1.0",
    "aws-cdk": "^2.1100.1",
    "aws-cdk-lib": "^2.233.0",
    "constructs": "^10.4.4",
    "dpdm": "^4.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  }
}
