{
  "name": "webapp",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "prettier:check": "prettier --check ./app",
    "prettier:write": "prettier --write ./app",
    "licenses:check": "license-checker-rseidelsohn --excludePrivatePackages --production --onlyAllow \"MIT;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;0BSD;Unlicense;CC0-1.0;BlueOak-1.0.0\" --summary",
    "licenses:check:dev": "license-checker-rseidelsohn --excludePrivatePackages --development --onlyAllow \"MIT;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;0BSD;Unlicense;CC0-1.0;BlueOak-1.0.0;MPL-2.0;Python-2.0;CC-BY-3.0;CC-BY-4.0\" --summary",
    "licenses:report": "node ../scripts/licenses-report.mjs",
    "licenses:notices": "license-checker-rseidelsohn --excludePrivatePackages --production --plainVertical --out build/client/third-party-licenses.txt"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "yarn": ">=4.0.0 <5.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@internationalized/date": "^3.12.4",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "@react-router/node": "^7.7.1",
    "@react-router/serve": "^7.7.1",
    "@sentry/react": "^10.10.0",
    "@urql/exchange-auth": "^3.0.0",
    "aws-amplify": "^6.15.4",
    "i18next": "^25.3.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "isbot": "^5",
    "loglevel": "^1.9.2",
    "p-retry": "^6.2.1",
    "react": "^19.1.0",
    "react-aria": "^3.52.1",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.6.1",
    "react-icons": "^5.5.0",
    "react-router": "^8.4.0",
    "urql": "^5.0.1",
    "zod": "^4.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.4",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "eslint": "^10.13.0",
    "graphql": "^16.12.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.4",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.49.0",
    "vite": "^8.3.4",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "packageManager": "yarn@4.18.1"
}
